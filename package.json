{
  "name": "mcp-enterprise-server",
  "version": "1.0.0",
  "description": "A Model Context Protocol (MCP) server that lets an LLM query a private SQL database through a small set of validated, read-only tools.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ckuudee/mcp-enterprise-server.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "typescript",
    "express",
    "zod"
  ],
  "author": "Cody",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ckuudee/mcp-enterprise-server/issues"
  },
  "homepage": "https://github.com/ckuudee/mcp-enterprise-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
